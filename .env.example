# ==============================================================================
# ORVEXA PRIME DIGITAL — CONFIGURAÇÃO DE AMBIENTE DE PRODUÇÃO
# ==============================================================================

# BANCO DE DADOS (PostgreSQL em Produção ou SQLite em Homologação)
DATABASE_URL="file:./dev.db"
# Para PostgreSQL: DATABASE_URL="postgresql://usuario:senha@localhost:5432/orvexa_prime?schema=public"

# AUTENTICAÇÃO JWT (Chave de 256 bits derivada)
JWT_SECRET="orvexa_prime_super_secret_jwt_key_2026_production_grade_token_guard_change_me_in_prod"

# CRIPTOGRAFIA SIMÉTRICA AES-256-GCM (Chave mestre para guardar chaves de API)
ORVEXA_CRYPTO_KEY="orvexa_prime_aes256_master_key_production_2026_antigravity_secret"

# GATEWAY FINANCEIRO & WEBHOOKS (Stripe / Mercado Pago / Asaas)
STRIPE_SECRET_KEY="sk_test_mock_orvexa_stripe_production_key"
STRIPE_WEBHOOK_SECRET="whsec_orvexa_prime_demo_secret_2026"

# ENDPOINT PÚBLICO DA APLICAÇÃO
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AMBIENTE & PORTA
NODE_ENV="production"
PORT=3000
