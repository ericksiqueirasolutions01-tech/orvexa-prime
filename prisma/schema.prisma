generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String
  planId        String?
  status        String         @default("PENDING_PAYMENT") // ACTIVE, BLOCKED, PENDING_PAYMENT
  role          String         @default("USER") // USER, ADMIN
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  plan          Plan?          @relation(fields: [planId], references: [id])
  subscriptions Subscription[]
  payments      Payment[]
  conversations Conversation[]
  usageLogs     UsageLog[]
  files         File[]
  auditLogs     AuditLog[]
  generatedImages GeneratedImage[]
  projects        Project[]
  projectFiles    ProjectFile[]
  projectMemories ProjectMemory[]
  memories        UserMemory[]
  agentMemories   AgentMemory[]
  conversationMemories ConversationMemory[]
  fileKnowledge        FileKnowledge[]
  agents               Agent[]
  aiUsageLogs          AiUsageLog[]

  @@index([email])
  @@index([status])
  @@index([role])
}

model Plan {
  id                String         @id @default(uuid())
  name              String         // FREE, PRO, BUSINESS, ENTERPRISE
  slug              String         @unique
  priceCents        Int            // in cents (ex: 7990 = R$ 79,90)
  monthlyTokens     Int            @default(100000) // Monthly token quota
  monthlyMessages   Int            @default(100)    // Mensagens mensais
  monthlyFiles      Int            @default(5)      // Arquivos processados no ciclo
  monthlyImages     Int            @default(10)     // Gerações de imagem no ciclo
  allowedAgents     String         @default("[\"ALL\"]") // JSON array de slugs de agentes autorizados
  allowedModels     String         // JSON array of allowed model slugs
  maxSeats          Int            @default(1)
  storageQuotaBytes Float        @default(524288000) // Limite de armazenamento em bytes (Float suporta até 9 Petabytes)
  features          String         // JSON array of features description
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  users             User[]
  subscriptions     Subscription[]
}

model Subscription {
  id                   String     @id @default(uuid())
  userId               String
  planId               String
  status               String     @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELED, TRIALING
  currentPeriodStart   DateTime   @default(now())
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean    @default(false)
  gatewayProvider      String     @default("STRIPE") // STRIPE, MERCADO_PAGO, ASAAS
  externalSubscriptionId String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 Plan       @relation(fields: [planId], references: [id])
  payments             Payment[]

  @@index([userId])
  @@index([status])
}

model Payment {
  id             String        @id @default(uuid())
  subscriptionId String?
  userId         String
  amountCents    Int
  currency       String        @default("BRL")
  status         String        @default("PENDING") // PENDING, CONFIRMED, FAILED, REFUNDED
  gateway        String        @default("STRIPE") // STRIPE, MERCADO_PAGO, ASAAS
  transactionId  String?
  receiptUrl     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([transactionId])
}

model AiProvider {
  id          String        @id @default(uuid())
  name        String        // Anthropic, OpenAI, Google
  slug        String        @unique // anthropic, openai, google
  baseUrl     String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  models      AiModel[]
  apiKeys     ApiKey[]
  routerRules RouterRule[]
}

model ApiKey {
  id                 String      @id @default(uuid())
  providerId         String
  name               String      // e.g., "Claude API 01", "OpenAI Key 02"
  encryptedKey       String      // AES-256-GCM cipher text
  iv                 String      // Initialization vector
  authTag            String      // Authentication tag
  keyHint            String      // Safe preview: "...x98a"
  tokenLimitMonthly  Int         @default(0) // 0 = unlimited
  tokensUsedMonth    Int         @default(0)
  priority           Int         @default(1) // 1 highest, 10 lowest
  customBaseUrl      String?     // Optional custom proxy endpoint (e.g. https://my-proxy.com/v1)
  capabilities       String      @default("[\"TEXTO\",\"CODIGO\",\"DOCUMENTO\"]") // JSON array
  costAccumulatedCents Float     @default(0)
  status             String      @default("ACTIVE") // ACTIVE, WARNING_90, BLOCKED_QUOTA, RATE_LIMITED, ERROR, DISABLED
  errorCount         Int         @default(0)
  lastUsedAt         DateTime?
  quarantinedUntil   DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  provider           AiProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  usageLogs          UsageLog[]
  messages           Message[]

  @@index([providerId])
  @@index([status])
  @@index([priority])
}

model AiModel {
  id                    String        @id @default(uuid())
  providerId            String
  name                  String        // e.g. "Claude 3.5 Sonnet", "GPT-4o", "Gemini 1.5 Pro"
  modelIdentifier       String        @unique // e.g. "claude-3-5-sonnet-20241022", "gpt-4o"
  category              String        // CODE, TEXT, RESEARCH, MULTIMODAL
  capabilities          String        @default("[\"TEXTO\"]") // JSON array of supported capabilities
  contextWindow         Int           @default(128000)
  costPer1kInputCents   Float         @default(0.3)
  costPer1kOutputCents  Float         @default(1.5)
  isActive              Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  provider              AiProvider    @relation(fields: [providerId], references: [id])
  agents                Agent[]
  usageLogs             UsageLog[]
  routerRules           RouterRule[]

  @@index([providerId])
  @@index([category])
}

model Agent {
  id               String         @id @default(uuid())
  userId           String?        // Criador do agente personalizado (null = nativo)
  projectId        String?        // Projeto vinculado
  name             String         // Nome do agente
  slug             String         @unique
  role             String         @default("Especialista")
  badge            String         @default("SPECIALIST")
  color            String         @default("cyan")
  avatar           String?        // Emoji, URL ou identificador de avatar
  description      String         // Descrição da função do agente
  instructions     String?        // Instruções personalizadas do agente
  systemPrompt     String         // Prompt mestre do sistema
  modelPreference  String?        @default("orvexa-prime") // Modelo preferencial: orvexa-prime, openai, claude, gemini
  preferredModelId String?
  iconName         String         @default("Bot")
  category         String         @default("GERAL")
  tools            String         @default("[]") // JSON string of tools array
  allowedRoles     String         @default("[\"USER\",\"ADMIN\"]")
  allowedPlans     String         @default("[\"ALL\"]") // ["ALL"] or ["PRO", "PREMIUM", "EMPRESA"]
  isSystem         Boolean        @default(true)
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user             User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project          Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  preferredModel   AiModel?       @relation(fields: [preferredModelId], references: [id])
  conversations    Conversation[]
  agentMemories    AgentMemory[]

  @@index([userId])
  @@index([projectId])
  @@index([category])
  @@index([isActive])
  @@index([isSystem])
}

model AgentMemory {
  id         String   @id @default(uuid())
  agentId    String
  userId     String
  key        String   // e.g. "stack_frontend", "brand_voice", "focus_subject", "target_cac"
  value      String   // Memory content
  category   String   @default("GENERAL") // STACK, PREFERENCE, FACT, RULE, CONTEXT
  tags       String   @default("[]") // JSON string of tags
  importance Int      @default(3) // 1 to 5
  embedding  String?  // JSON float array vector embedding
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([agentId, userId])
  @@index([agentId])
  @@index([userId])
  @@index([key])
}

model Conversation {
  id              String      @id @default(uuid())
  userId          String
  agentId         String?
  title           String      @default("Nova Conversa")
  modelPreference String      @default("orvexa-prime") // "claude", "openai", "gemini", "orvexa-prime"
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent           Agent?      @relation(fields: [agentId], references: [id])
  projectId       String?
  project         Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectConversations ProjectConversation[]
  messages        Message[]
  files           File[]
  memories        ConversationMemory[]

  @@index([userId])
  @@index([projectId])
  @@index([createdAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String       // USER, ASSISTANT, SYSTEM
  content        String
  tokensIn       Int          @default(0)
  tokensOut      Int          @default(0)
  costCents      Float        @default(0)
  latencyMs      Int          @default(0)
  apiKeyUsedId   String?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  apiKeyUsed     ApiKey?      @relation(fields: [apiKeyUsedId], references: [id])

  @@index([conversationId])
  @@index([createdAt])
  @@index([conversationId, createdAt])
}

model UsageLog {
  id                String    @id @default(uuid())
  userId            String
  modelId           String?
  apiKeyId          String?
  tokensInput       Int       @default(0)
  tokensOutput      Int       @default(0)
  totalTokens       Int       @default(0)
  costCents         Float     @default(0)
  priceChargedCents Float     @default(0)
  latencyMs         Int       @default(0)
  status            String    @default("SUCCESS") // SUCCESS, FAILOVER, FAILED
  createdAt         DateTime  @default(now())

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  model             AiModel?  @relation(fields: [modelId], references: [id])
  apiKey            ApiKey?   @relation(fields: [apiKeyId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([status])
  @@index([userId, createdAt])
}

model File {
  id             String        @id @default(uuid())
  userId         String
  conversationId String?
  originalName   String
  storedPath     String
  fileSizeBytes  Int
  mimeType       String
  category       String        @default("DOCUMENT") // DOCUMENT, SPREADSHEET, PRESENTATION, IMAGE, CODE, ARCHIVE
  isGenerated    Boolean       @default(false)
  previewData    String?       // JSON string of sheet previews, rows, or thumbnail
  extractedText  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  knowledgeChunks FileKnowledge[]

  @@index([userId])
  @@index([conversationId])
  @@index([category])
  @@index([isGenerated])
  @@index([userId, createdAt])
}

model AuditLog {
  id           String    @id @default(uuid())
  actorId      String?
  action       String    // e.g. API_KEY_CREATED, USER_BLOCKED, ROUTER_RULE_UPDATED
  resourceType String    // USER, API_KEY, PLAN, ROUTER, PAYMENT
  resourceId   String?
  details      String?   // JSON string
  ipAddress    String?
  createdAt    DateTime  @default(now())

  actor        User?     @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model RouterRule {
  id               String     @id @default(uuid())
  intentName       String     // PROGRAMACAO, TEXTO_COPY, PESQUISA, DOCUMENTOS
  keywords         String     // JSON array string of trigger keywords
  targetProviderId String
  targetModelId    String
  priority         Int        @default(1)
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  targetProvider   AiProvider @relation(fields: [targetProviderId], references: [id])
  targetModel      AiModel    @relation(fields: [targetModelId], references: [id])

  @@index([intentName])
  @@index([isActive])
}

model GeneratedImage {
  id             String    @id @default(uuid())
  userId         String
  prompt         String
  refinedPrompt  String?
  modelUsed      String
  imageUrl       String
  style          String?   // REALISTA, CYBERPUNK, 3D, MINIMALISTA, LOGO
  dimensions     String    @default("1024x1024")
  createdAt      DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model Project {
  id                  String                @id @default(uuid())
  userId              String
  name                String
  slug                String?
  segment             String?               @default("GENERAL") // LOJA, CLINICA, RESTAURANTE, IGREJA, ADVOGADO, PETSHOP, LANDING, GENERAL
  description         String?
  customInstructions  String?               // Instruções personalizadas do projeto e tom de voz
  layoutData          String?               // JSON representation of site layout & blocks
  status              String                @default("ACTIVE") // ACTIVE, DRAFT, GENERATING, PUBLISHED, ARCHIVED
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  files               ProjectFile[]
  memories            ProjectMemory[]
  conversations       Conversation[]
  projectConversations ProjectConversation[]
  agents              Agent[]

  @@index([userId])
  @@index([status])
}

model ProjectFile {
  id             String       @id @default(uuid())
  projectId      String
  userId         String
  fileName       String
  fileSize       Int          @default(0)
  fileType       String?
  fileUrl        String?
  extractedText  String?
  createdAt      DateTime     @default(now())

  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
}

model ProjectMemory {
  id             String       @id @default(uuid())
  projectId      String
  userId         String
  key            String?      // e.g. "tom_de_comunicacao", "ramo_atuacao", "clientes_principais"
  content        String       // Conteúdo da informação importante memorizada
  category       String       @default("CONTEXT") // CONTEXT, RULE, FACT, PREFERENCE
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
}

model ProjectConversation {
  id             String       @id @default(uuid())
  projectId      String
  conversationId String
  createdAt      DateTime     @default(now())

  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([projectId, conversationId])
  @@index([projectId])
  @@index([conversationId])
}

model Template {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  segment     String    // LOJA, CLINICA, RESTAURANTE, IGREJA, ADVOGADO, PETSHOP, LANDING
  description String
  previewUrl  String?
  layoutData  String    // JSON template blocks
  isSystem    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique // e.g. "default_model", "coding_model", "document_model", "image_model"
  value     String   // Value or JSON configuration
  category  String   @default("AI") // AI, SECURITY, SYSTEM
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([key])
  @@index([category])
}

model UserMemory {
  id         String   @id @default(uuid())
  userId     String
  key        String   // e.g. "preferred_language", "company_name", "tech_stack"
  value      String   // Memory content
  category   String   @default("GENERAL") // PREFERENCE, FACT, PROJECT, CODING, PEDAGOGICAL, BUSINESS
  tags       String   @default("[]") // JSON string of tags
  importance Int      @default(3) // 1 (low) to 5 (critical)
  embedding  String?  // JSON float array vector embedding
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@index([key])
  @@index([userId, category])
  @@index([userId, importance])
}

model ConversationMemory {
  id             String       @id @default(uuid())
  userId         String
  conversationId String
  title          String
  summary        String       // Semantic summary of discussion / conclusions
  keyTakeaways   String       @default("[]") // JSON array of bullet points
  tags           String       @default("[]") // JSON array of tags
  embedding      String?      // JSON float array vector embedding
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([conversationId])
  @@index([createdAt])
}

model FileKnowledge {
  id             String    @id @default(uuid())
  userId         String
  fileId         String
  fileName       String
  chunkIndex     Int       @default(0)
  content        String    // Text segment from document/spreadsheet/code
  summary        String?   // Micro-summary of this chunk
  category       String    @default("DOCUMENT")
  embedding      String?   // JSON float array vector embedding
  metadata       String?   // JSON string with page, sheet, line, mimeType
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  file           File      @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([fileId])
  @@index([category])
}

model AiUsageLog {
  id           String    @id @default(uuid())
  userId       String?
  provider     String    // openai, mirai, openrouter, azure, anthropic, google
  model        String    // gpt-4o, claude-3-5-sonnet, gemini-1.5-flash, etc.
  tokensInput  Int       @default(0)
  tokensOutput Int       @default(0)
  totalTokens  Int       @default(0)
  cost         Float     @default(0) // Custo estimado em USD
  costBrl      Float     @default(0) // Custo convertido para BRL
  latencyMs    Int       @default(0)
  statusCode   Int       @default(200)
  status       String    @default("SUCCESS") // SUCCESS, ERROR, RATE_LIMIT, TIMEOUT, FALLBACK
  errorMessage String?
  createdAt    DateTime  @default(now())

  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([provider])
  @@index([model])
  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@map("ai_usage_logs")
}

model ProviderHealth {
  id           String    @id @default(uuid())
  providerSlug String    @unique // openai, mirai, openrouter, azure, anthropic, google
  name         String
  category     String    @default("OPENAI_OFFICIAL") // OPENAI_OFFICIAL, OPENAI_COMPATIBLE, ANTHROPIC, GOOGLE
  status       String    @default("ONLINE") // ONLINE, OFFLINE, INVALID_KEY, EXPIRED, RATE_LIMIT
  httpStatus   Int       @default(200)
  latencyMs    Int       @default(0)
  availability Float     @default(100.0) // % de disponibilidade (uptime)
  lastTestedAt DateTime  @default(now())
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([providerSlug])
  @@index([status])
  @@map("provider_health")
}

model AiProviderKey {
  id              String    @id @default(uuid())
  provider        String    // openai, mirai, anthropic, google, openrouter, azure
  name            String
  encryptedKey    String
  iv              String?
  authTag         String?
  keyHint         String?   // ...x98a
  tokenLimit      Int       @default(0) // total contratado
  monthlyLimit    Int       @default(0) // limite mensal
  dailyLimit      Int       @default(0) // limite diário
  initialBalance  Int       @default(0) // saldo inicial
  tokensUsed      Int       @default(0) // tokens consumidos
  tokensRemaining Int       @default(0) // tokens restantes
  costAccumulated Float     @default(0) // custo acumulado em USD
  expirationDate  DateTime? // data de expiração
  renewalDate     DateTime? // data de renovação
  customBaseUrl   String?
  status          String    @default("ACTIVE") // ACTIVE, DISABLED, EXPIRED, WARNING_80, WARNING_90, ERROR, RATE_LIMITED
  lastTestedAt    DateTime?
  lastLatencyMs   Int       @default(0)
  detectedModels  String?   // JSON array de modelos
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([provider])
  @@index([status])
  @@index([expirationDate])
  @@map("ai_provider_keys")
}

model AiProviderAccount {
  id               String    @id @default(uuid())
  provider         String    // mirai, openai, anthropic, google, openrouter, azure
  accountName      String
  apiKeyMasked     String
  encryptedKey     String?
  iv               String?
  authTag          String?
  totalQuota       Int       @default(0) // total contratado em tokens
  usedQuota        Int       @default(0) // tokens consumidos
  remainingQuota   Int       @default(0) // tokens restantes
  quotaType        String    @default("TOKENS") // TOKENS, CREDITS_USD, UNLIMITED
  expirationDate   DateTime?
  renewalDate      DateTime?
  lastSync         DateTime  @default(now())
  status           String    @default("CONNECTED") // CONNECTED, INVALID, EXPIRED, LIMIT_REACHED
  customBaseUrl    String?
  todayTokens      Int       @default(0)
  monthTokens      Int       @default(0)
  estimatedCostUsd Float     @default(0)
  projectedCostUsd Float     @default(0)
  detectedModels   String?   // JSON array de modelos suportados
  lastLatencyMs    Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([provider])
  @@index([status])
  @@index([expirationDate])
  @@map("ai_provider_accounts")
}



